{
  "openapi": "3.1.0",
  "info": {
    "title": "Fleeticc Partner API",
    "description": "Live and historical GPS for partner backends. HMAC-SHA256 auth. Base: https://api.fleeticc.com",
    "version": "1.0.0",
    "contact": {
      "email": "info@fleeticc.com",
      "url": "https://fleeticc.com/contact"
    }
  },
  "servers": [
    {
      "url": "https://api.fleeticc.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "PartnerHmac": []
    }
  ],
  "components": {
    "securitySchemes": {
      "PartnerHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Also send X-Timestamp and X-Signature (HMAC-SHA256). See docs authentication page."
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "200" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "401" },
          "message": { "type": "string" },
          "data": { "nullable": true },
          "error": { "type": "string", "example": "PARTNER_AUTH_INVALID" }
        }
      },
      "PartnerVehicle": {
        "type": "object",
        "properties": {
          "vehicleId": { "type": "string", "format": "uuid" },
          "imei": { "type": "string" },
          "plateNumber": { "type": "string" },
          "vehicleName": { "type": "string" }
        }
      },
      "PartnerLivePoint": {
        "type": "object",
        "properties": {
          "vehicleId": { "type": "string" },
          "imei": { "type": "string" },
          "plateNumber": { "type": "string" },
          "vehicleName": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "speed": { "type": "number" },
          "course": { "type": "number" },
          "accstatus": { "type": "integer" },
          "gpstime": { "type": "integer" },
          "servertime": { "type": "integer" },
          "hearttime": { "type": "integer" },
          "datastatus": { "type": "integer" },
          "lastSeen": { "type": "integer" }
        }
      },
      "PartnerHistoryPoint": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "integer" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "speed": { "type": "number" },
          "heading": { "type": "number" },
          "accstatus": { "type": "integer", "nullable": true }
        }
      }
    }
  },
  "paths": {
    "/api/partner/v1/vehicles": {
      "get": {
        "summary": "List vehicles",
        "operationId": "partnerListVehicles",
        "responses": {
          "200": {
            "description": "Owner vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiSuccess" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/v1/track": {
      "get": {
        "summary": "Live GPS snapshot",
        "operationId": "partnerTrackSnapshot",
        "parameters": [
          {
            "name": "imeis",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated IMEIs (1–100)"
          },
          {
            "name": "vehicleIds",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated vehicle UUIDs"
          }
        ],
        "responses": {
          "200": { "description": "Live positions" }
        }
      }
    },
    "/api/partner/v1/track/stream": {
      "get": {
        "summary": "Live GPS SSE stream",
        "operationId": "partnerTrackStream",
        "parameters": [
          {
            "name": "imeis",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "vehicleIds",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/partner/v1/history": {
      "get": {
        "summary": "GPS history or nearest point",
        "operationId": "partnerHistory",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "imei",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "from",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Range start (Unix seconds)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Range end (Unix seconds)"
          },
          {
            "name": "at",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Nearest-point timestamp (QR scan)"
          },
          {
            "name": "windowSeconds",
            "in": "query",
            "schema": { "type": "integer", "default": 300 }
          }
        ],
        "responses": {
          "200": { "description": "History range or nearest point" }
        }
      }
    }
  }
}
